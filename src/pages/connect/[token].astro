---
import SessionInvitePage from "../../components/SessionInvitePage.astro";
import { isValidToken } from "../../lib/links";

// Alias of /s/<token>. Both paths are listed in the app-link association
// files, so both have to keep rendering the same page.
export const prerender = false;

const token = Astro.params.token ?? "";
if (!isValidToken(token)) Astro.response.status = 404;
---

<SessionInvitePage token={token} />
