---
import { getEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";
import MarkdownActions from "../components/MarkdownActions.astro";

// The Markdown file is the source of truth for this page's claims; /privacy.md
// serves the very same file. There is no second copy to fall out of date.
const entry = await getEntry("pages", "privacy");
if (!entry) throw new Error("src/content/pages/privacy.md is missing");
const { Content } = await render(entry);
---

<Base title="azula — privacy" description={entry.data.description} markdown="/privacy.md">
  <div class="hero">
    <div class="doc-head">
      <h1>{entry.data.title}</h1>
      <MarkdownActions href="/privacy.md" />
    </div>
  </div>

  <div class="sec prose">
    <Content />
  </div>
</Base>
